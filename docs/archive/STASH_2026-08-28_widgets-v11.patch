+            <div class="flex justify-between items-center mb-2">
+                <b>${esc(r.channel)} · ${esc(r.run_date)}</b>
+                <button class="btn btn-sm btn-secondary" onclick="document.getElementById('summarizerRunView').classList.add('hidden')">✕</button>
+            </div>
+            <pre class="text-sm" style="white-space:pre-wrap; max-height:420px; overflow:auto">${esc(r.summary_md || '(пусто)')}</pre>
+        </div>`;
+    } catch (e) { toast(e.message, 'error'); }
+}
+
+async function summarizerDeleteRun(runId) {
+    const acc = _brainAcc(); if (!acc) return;
+    const res = await api(`/api/accounts/${acc}/summarizer/runs/${runId}`, jopts('DELETE', {}));
+    if (res.ok) loadSummarizerRuns(); else toast(res.error || 'Ошибка', 'error');
+}
+
+// ---------- Shift ----------
+async function loadShift() {
+    const acc = _brainAcc(); if (!acc) return;
+    try {
+        const res = await api(`/api/accounts/${acc}/shift?channel=${encodeURIComponent(_brainCh())}`);
+        document.getElementById('shiftEnabled').checked = !!res.enabled;
+        document.getElementById('shiftIntensity').value = String(res.intensity ?? 0);
+        const st = res.active;
+        document.getElementById('shiftStatus').textContent = st
+            ? `активен: ${st.kind}, ~${Math.round((st.remaining_sec || 0) / 60)} мин (mood ${st.mood_delta >= 0 ? '+' : ''}${st.mood_delta})`
+            : 'сейчас сдвигов нет';
+    } catch (e) { /* ignore */ }
+}
+
+async function shiftSet() {
+    const acc = _brainAcc(); if (!acc) return;
+    const enabled = document.getElementById('shiftEnabled')?.checked;
+    const intensity = parseInt(document.getElementById('shiftIntensity')?.value || '0');
+    const res = await api(`/api/accounts/${acc}/shift`, jopts('POST', { enabled, intensity, channel: _brainCh() }));
+    if (res && res.enabled !== undefined) loadShift();
+}
+
+// ---------- Memory (confirm) ----------
+async function loadBrainMemory() {
+    const box = document.getElementById('brainMemoryList');
+    const acc = _brainAcc(); if (!box || !acc) return;
+    try {
+        const res = await api(`/api/accounts/${acc}/memory?limit=30`);
+        const users = Array.isArray(res) ? res : (res.items || res.users || []);
+        if (!users.length) { box.innerHTML = '<div class="empty-state text-muted text-sm">Память пуста.</div>'; return; }
+        box.innerHTML = users.map(u => {
+            const facts = (u.facts_structured || []).map(f => {
+                const conf = f.confirmed
+                    ? `<button class="btn btn-sm btn-secondary" title="Снять подтверждение" onclick="brainConfirmFact('${esc(u.username)}', '${esc(f.fact)}', false)">✓✓</button>`
+                    : `<button class="btn btn-sm btn-secondary" title="Подтвердить (живёт дольше, идёт первым)" onclick="brainConfirmFact('${esc(u.username)}', '${esc(f.fact)}', true)">✓</button>`;
+                return `<div class="flex justify-between items-center gap-2 text-sm mb-1">
+                    <span>${esc(f.fact)} <span class="text-xs text-muted">pr ${f.priority ?? 50} · conf ${(f.confidence ?? 0).toFixed(2)}${f.expires_at ? ' · до ' + esc(String(f.expires_at).slice(0, 10)) : ''}</span></span>
+                    <span class="flex gap-1">${conf}</span></div>`;
+            }).join('');
+            return `<div class="p-2 mb-1" style="border-bottom:1px solid var(--border,#eee)">
+                <div class="text-sm font-semibold mb-1">${esc(u.username)} <span class="text-xs text-muted">(${u.msg_count || 0} сообщ.)</span></div>
+                ${facts || '<div class="text-xs text-muted">нет фактов</div>'}</div>`;
+        }).join('');
+    } catch (e) { box.innerHTML = `<div class="text-error text-sm">${esc(e.message)}</div>`; }
+}
+
+async function brainConfirmFact(username, fact, confirmed) {
+    const acc = _brainAcc(); if (!acc) return;
+    const res = await api(`/api/accounts/${acc}/memory/${encodeURIComponent(username)}/confirm`, jopts('POST', { fact, confirmed }));
+    if (res.ok) loadBrainMemory(); else toast(res.error || 'Ошибка', 'error');
+}
+
+// ── §9e/§9g/§9h/§6: карточки на главной странице бота ──
+function _firstChannel() {
+    return (_channelsCache[0]?.channel_name || (_botStatuses[_currentBotId]?.channels || [])[0] || '');
+}
+
+async function loadBotOverviewExtras() {
+    loadQuickBehavior();
+    loadStreamerMood();
+    loadClipMoments();
+    loadReplaySessionsList();
+}
+
+async function loadQuickBehavior() {
+    if (!_currentBotId) return;
+    try {
+        const cfg = await api(`/api/accounts/${_currentBotId}/analyzer`);
+        if ($('quickAutoChat')) $('quickAutoChat').checked = !(cfg.auto_chat === false);
+        if ($('quickSilent')) $('quickSilent').checked = !!cfg.silent_mode;
+    } catch (e) { console.warn('quick behavior', e); }
+    try {
+        const bot = _allBots.find(b => b.id === _currentBotId);
+        if ($('quickObservation')) $('quickObservation').checked = !!(bot && bot.observation_only);
+    } catch (e) { /* noop */ }
+}
+
+async function saveQuickBehavior() {
+    if (!_currentBotId) return;
+    try {
+        await api(`/api/accounts/${_currentBotId}/analyzer`, jopts('PUT', {
+            auto_chat: !!$('quickAutoChat')?.checked,
+            silent_mode: !!$('quickSilent')?.checked,
+        }));
+        toast(t('msg.saved'), 'success');
+    } catch (e) { toast(t('toast.error_detail', {detail: e.message}), 'error'); }
+}
+
+async function saveQuickObservation() {
+    if (!_currentBotId) return;
+    const value = !!$('quickObservation')?.checked;
+    try {
+        await api(`/api/accounts/${_currentBotId}`, jopts('PUT', { observation_only: value }));
+        const bot = _allBots.find(b => b.id === _currentBotId);
+        if (bot) bot.observation_only = value;
+        toast(t(value ? 'toast.observation_enabled' : 'toast.observation_disabled'), 'success');
+    } catch (e) { toast(t('toast.error_detail', {detail: e.message}), 'error'); }
+}
+
+// §9e: настроение стримера (read-only)
+async function loadStreamerMood() {
+    const box = $('moodSnapshot');
+    if (!box || !_currentBotId) return;
+    const channel = _firstChannel();
+    if (!channel) { box.innerHTML = `<span class="text-muted">${esc(t('status.no_channel_bot'))}</span>`; return; }
+    try {
+        const res = await api(`/api/streamer-mood/${_currentBotId}?channel=${encodeURIComponent(channel)}`);
+        if (!res.ok) { box.innerHTML = `<span class="text-muted">${esc(res.error || t('label.no_data'))}</span>`; return; }
+        const s = res.snapshot || {};
+        const moodEmoji = { rage: '😠', hype: '🤩', sad: '😢', chill: '😌', neutral: '😐' };
+        const label = s.label || 'neutral';
+        const pct = v => Math.round((v || 0) * 100);
+        box.innerHTML = `<div class="flex gap-2 flex-wrap items-center">
+            <span class="badge">${moodEmoji[label] || '😐'} ${esc(String(label))}</span>
+            <span class="bot-card-badge">🔥 ${pct(s.score_hype)}%</span>
+            <span class="bot-card-badge">😠 ${pct(s.score_rage)}%</span>
+            <span class="bot-card-badge">😢 ${pct(s.score_sad)}%</span>
+            <span class="bot-card-badge">😌 ${pct(s.score_chill)}%</span>
+            <span class="text-xs text-muted">#${esc(channel)}</span>
+        </div>
+        ${s.last_text ? `<div class="text-xs text-muted mt-2">«${esc(String(s.last_text).substring(0, 120))}»</div>` : ''}`;
+    } catch (e) { box.innerHTML = `<span class="text-muted">${esc(t('label.no_data'))}</span>`; }
+}
+
+// §9g: клипы
+async function checkClipSpike() {
+    if (!_currentBotId) return;
+    const channel = _firstChannel();
+    const box = $('clipCheckResult');
+    if (!channel) { toast(t('status.no_channel_bot'), 'error'); return; }
+    try {
+        const res = await api(`/api/bot/clip-detector/check/${_currentBotId}/${encodeURIComponent(channel)}`);
+        box.innerHTML = res.spike
+            ? `<span class="text-success">🔥 ${esc(t('clips.spike_yes'))} — ${res.rate}/сек (ср. ${res.avg_rate}/сек)</span>`
+            : `<span class="text-muted">${esc(t('clips.spike_no'))} — ${res.rate}/сек (ср. ${res.avg_rate}/сек)</span>`;
+    } catch (e) { box.innerHTML = `<span class="text-error">${esc(e.message)}</span>`; }
+}
+
+async function createClipManually() {
+    if (!_currentBotId) return;
+    const channel = _firstChannel();
+    if (!channel) { toast(t('status.no_channel_bot'), 'error'); return; }
+    try {
+        const res = await api('/api/bot/clip-detector/create-clip', jopts('POST', {
+            account_id: _currentBotId, channel,
+        }));
+        if (res.ok) toast(t('clips.created', {detail: (res.clip_url || res.clip_id || '').toString().substring(0, 50)}), 'success');
+        else toast(t('toast.error_detail', {detail: res.error || t('send.reason.unknown')}), 'error');
+        await loadClipMoments();
+    } catch (e) { toast(t('toast.error_detail', {detail: e.message}), 'error'); }
+}
+
+async function loadClipMoments() {
+    const box = $('clipMomentsList');
+    if (!box || !_currentBotId) return;
+    try {
+        const res = await api(`/api/bot/clip-detector/moments/${_currentBotId}`);
+        const moments = res.items || [];
+        box.innerHTML = moments.slice(0, 5).map(m => `
+            <div class="flex items-center gap-2 text-sm">
+                <span class="badge">🎬</span>
+                <span style="flex:1">${esc(String(m.timestamp || m.created_at || '').substring(0, 19))} · ${esc(String(m.rate ?? ''))}/сек</span>
+                ${m.clip_url ? `<a href="https://clips.twitch.tv/${esc(m.clip_url)}" target="_blank" rel="noopener" class="text-accent text-xs">${esc(t('clips.open'))}</a>` : ''}
+            </div>`).join('') || `<div class="text-muted text-sm">${esc(t('clips.no_moments'))}</div>`;
+    } catch (e) { box.innerHTML = `<div class="text-muted text-sm">${esc(t('clips.no_moments'))}</div>`; }
+}
+
+// §9h: replay sessions
+async function loadReplaySessionsList() {
+    const box = $('replaySessionsList');
+    if (!box) return;
+    try {
+        const res = await api('/api/replay/sessions?limit=5');
+        box.innerHTML = (res.sessions || []).map(s => `
+            <div class="flex items-center gap-2 text-sm">
+                <span class="badge">${!s.ended_at ? '⏺' : '✓'}</span>
+                <span class="font-semibold">${esc(s.name || '#' + s.id)}</span>
+                <span class="text-muted" style="flex:1">#${esc(s.channel || '')} · ${esc(String(s.n_events ?? 0))} ${t('replay.messages')}</span>
+            </div>`).join('') || `<div class="text-muted text-sm">${esc(t('replay.empty'))}</div>`;
+    } catch (e) { box.innerHTML = `<div class="text-muted text-sm">${esc(t('replay.empty'))}</div>`; }
+}
+
+async function startReplaySession() {
+    if (!_currentBotId) return;
+    const channel = _firstChannel();
+    if (!channel) { toast(t('status.no_channel_bot'), 'error'); return; }
+    try {
+        const res = await api('/api/replay/sessions/start', jopts('POST', {
+            account_id: _currentBotId, channel,
+            name: `stream_${new Date().toISOString().slice(0, 16)}`,
+        }));
+        if (res.ok) toast(t('replay.started'), 'success');
+        else toast(t('toast.error_detail', {detail: res.error || t('send.reason.unknown')}), 'error');
+        await loadReplaySessionsList();
+    } catch (e) { toast(t('toast.error_detail', {detail: e.message}), 'error'); }
+}
+
+async function endReplaySession() {
+    if (!_currentBotId) return;
+    try {
+        const res = await api('/api/replay/sessions');
+        const sessions = res.sessions || [];
+        const mine = sessions.find(s => s.account_id === _currentBotId && !s.ended_at);
+        if (!mine) { toast(t('replay.none_active'), 'info'); return; }
+        const end = await api(`/api/replay/sessions/${mine.id}/end`, { method: 'POST' });
+        if (end.ok) toast(t('replay.ended'), 'success');
+        await loadReplaySessionsList();
+    } catch (e) { toast(t('toast.error_detail', {detail: e.message}), 'error'); }
+}
