+        return False, "broadcaster_not_found"
+    moderator_id = await get_user_id(moderator_login, token) if moderator_login else None
+    if not moderator_id:
+        return False, "moderator_not_found"
+    target_id = await get_user_id(username, token)
+    if not target_id:
