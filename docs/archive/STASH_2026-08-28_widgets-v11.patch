-def chunk_transcript(text: str, *, target_words: int = 80, overlap_words: int = 20) -> list[str]:
-    """Режет длинный текст на параграфы по N слов.
-
-    Учитывает overlap чтобы не терять контекст на границах.
-    """
-    words = text.split()
-    if not words:
-        return []
-    if len(words) <= target_words:
-        return [text.strip()]
-    chunks = []
-    i = 0
-    step = max(1, target_words - overlap_words)
-    while i < len(words):
-        slice_ = words[i:i + target_words]
-        if not slice_:
-            break
-        chunks.append(" ".join(slice_).strip())
-        if i + target_words >= len(words):
-            break
-        i += step
-    return chunks
