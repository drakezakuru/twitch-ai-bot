+// ---------- Lore ----------
+async function loadLore() {
+    const box = document.getElementById('loreList');
+    const acc = _brainAcc(); if (!box || !acc) return;
+    try {
+        const res = await api(`/api/accounts/${acc}/lore?channel=${encodeURIComponent(_brainCh())}&limit=100`);
+        const items = res.items || [];
+        if (!items.length) { box.innerHTML = '<div class="empty-state text-muted text-sm">Пока нет фактов. Добавь вручную или запусти Summarizer.</div>'; return; }
+        box.innerHTML = items.map(it => {
+            const st = it.status || 'suggested';
+            const badge = st === 'approved' ? '<span class="badge badge-success">approved</span>'
+                : st === 'rejected' ? '<span class="badge">rejected</span>'
+                : '<span class="badge badge-warning">suggested</span>';
+            const acts = [];
+            if (st !== 'approved') acts.push(`<button class="btn btn-sm btn-primary" onclick="loreAct(${it.id}, 'approve')">✓</button>`);
+            if (st !== 'rejected') acts.push(`<button class="btn btn-sm btn-secondary" onclick="loreAct(${it.id}, 'reject')">✕</button>`);
+            acts.push(`<button class="btn btn-sm btn-secondary" onclick="loreDelete(${it.id})">🗑</button>`);
+            return `<div class="p-2 mb-1" style="border-bottom:1px solid var(--border,#eee)">
+                <div class="flex justify-between items-start gap-2">
+                    <div><div class="text-sm">${esc(it.fact)}</div>
+                    <div class="text-xs text-muted">источник: ${esc(it.source)} · conf ${(it.confidence ?? 0).toFixed(2)} · важность ${it.importance ?? 50}${it.evidence ? ' · ' + esc(it.evidence) : ''}</div></div>
+                    <div class="flex gap-1 items-center">${badge}${acts.join('')}</div>
+                </div></div>`;
+        }).join('');
+    } catch (e) { box.innerHTML = `<div class="text-error text-sm">${esc(e.message)}</div>`; }
