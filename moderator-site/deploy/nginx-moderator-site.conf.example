# MOD-22 example: reverse-proxy for the moderator public origin.
# Owner panel port is NOT proxied and must never appear here.
server {
    listen 8443 ssl;
    server_name mod.example.com;

    ssl_certificate     /etc/modsite/tls/mod.example.com.crt;
    ssl_certificate_key /etc/modsite/tls/mod.example.com.key;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'" always;

    location / {
        proxy_pass http://127.0.0.1:8443;  # gateway listens on loopback only
        proxy_set_header Host $host;
        proxy_set_header Origin $origin;
    }
}
