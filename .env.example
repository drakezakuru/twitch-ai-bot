# === Twitch ===
# OAuth-токен бота (получить на https://twitchtokengenerator.com/ или через Twitch CLI)
TWITCH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxx
# Имя бота (ник аккаунта Twitch)
TWITCH_BOT_NICK=my_bot_name
# Канал(ы) для подключения (через запятую)
TWITCH_CHANNELS=channel1,channel2

# === AI-провайдер ===
# Выберите: openrouter | ollama | gemini | openai | anthropic
# v10.4.3: добавлены прямые провайдеры (без обёртки OpenRouter), у каждого свой rate-limit.
AI_PROVIDER=openrouter

# === OpenRouter (если AI_PROVIDER=openrouter) ===
# API-ключ (получить бесплатно на https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxx
# Модель для анализа изображений (с поддержкой vision)
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-exp:free
# Модель для генерации текстовых ответов
OPENROUTER_CHAT_MODEL=google/gemini-2.0-flash-exp:free

# === Ollama (если AI_PROVIDER=ollama) ===
# Адрес Ollama-сервера
OLLAMA_HOST=http://localhost:11434
# Модель для vision
OLLAMA_VISION_MODEL=llava
# Модель для текста
OLLAMA_CHAT_MODEL=llama3

# === Google Gemini (если AI_PROVIDER=gemini) — v10.4.3 ===
# API-ключ: https://aistudio.google.com/apikey (бесплатный tier есть!)
# GEMINI_API_KEY=AIzaSy...
# Multimodal-модель (один и тот же gemini-2.0-flash умеет и chat и vision)
# GEMINI_CHAT_MODEL=gemini-2.0-flash
# GEMINI_VISION_MODEL=gemini-2.0-flash

# === OpenAI (если AI_PROVIDER=openai) — v10.4.3 ===
# API-ключ: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# Если используешь self-hosted OpenAI-совместимый proxy (например, vLLM, LM Studio):
# OPENAI_API_BASE=https://api.openai.com/v1

# === Anthropic Claude (если AI_PROVIDER=anthropic) — v10.4.3 ===
# API-ключ: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_VISION_MODEL=claude-3-5-sonnet-latest

# === Настройки бота ===
# Интервал анализа кадров стрима (секунды)
FRAME_INTERVAL=30
# Интервал анализа аудио (секунды)
AUDIO_INTERVAL=60
# Язык для Whisper-транскрипции (ru, en, и т.д.)
WHISPER_LANGUAGE=ru
# Размер модели Whisper (tiny, base, small, medium, large)
WHISPER_MODEL_SIZE=base
# Максимальная длина сообщения в чат (Twitch лимит 500)
MAX_CHAT_MESSAGE_LENGTH=450
# Префикс команд бота в чате
BOT_COMMAND_PREFIX=!
# Качество стрима для захвата (best, worst, 720p, 480p и т.д.)
STREAM_QUALITY=480p

# v10.4.2: сохранять каждый кадр на диск (для архива «что увидел AI»)
SAVE_FRAMES=1
# Сколько последних кадров хранить per-channel (старше удаляются)
MAX_SAVED_FRAMES=50
# Папка хранения сохранённых кадров (раздаётся по /frames/)
FRAMES_DIR=data/stream_vision_frames
# Авто-fallback на best/worst если выбранное качество недоступно (фикс rc=183)
QUALITY_FALLBACK=1

# v11: Voice cloning (Piper fine-tune) — папки хранения моделей/клонов.
# По умолчанию — относительно корня проекта, менять не обязательно.
# VOICE_MODELS_DIR=data/voice_models
# VOICE_CLONES_DIR=data/voice_clones

# ============================================================
# === Опциональные дополнения (можно не трогать) ===
# ============================================================

# --- Сетевой доступ к панели + шифрование токенов ---
# Обычный запуск: localhost/127.0.0.1 без пароля.
# Для явного доступа из LAN/сети нужны ВСЕ три значения:
# PANEL_AUTH_USER=admin
# PANEL_AUTH_PASS=mySecretPassword123
# TOKEN_ENCRYPTION_KEY=<см. ниже>
# PANEL_BIND_HOST=0.0.0.0
# PANEL_ALLOW_INSECURE_LOCAL устарел: localhost и так работает без пароля,
# а сетевой bind этот флаг никогда не разрешает.
# Ключ шифрования (32 url-safe base64 байта). Сгенерируй один раз и сохрани:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEY=

# --- Twitch Helix API + Device Code Login ---
# Зарегистрируй приложение на https://dev.twitch.tv/console/apps
#   * OAuth Redirect URLs: http://localhost
#   * Category: Application Integration
#   * Client Type: Public (для Device Code Flow и UI-логина без секрета)
# TWITCH_CLIENT_ID нужен для:
#   - Кнопки «Войти через Twitch» (Device Code Flow) — БЕЗ ручной вставки токена
#   - Feature 4: Контекст канала в AI-промпте
#   - Feature 3: EventSub WebSocket
# TWITCH_CLIENT_SECRET нужен только для Feature 2: авто-refresh токенов
# (для public-приложений Twitch refresh_token работает БЕЗ секрета,
#  но рекомендуется Confidential тип + secret для refresh)
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# --- Feature 6: Прокси по умолчанию для всех ботов (опционально) ---
# Поддерживается http://, https://, socks5://
# Можно задавать прокси индивидуально на каждый аккаунт через UI — это default.
# DEFAULT_PROXY=

# ============================================================
# === v10.4.3: OBS / custom источник для Stream Vision ===
# ============================================================
# Источник стрима для AI-зрения. По умолчанию (twitch) бот тянет HLS через
# streamlink — это даёт ~3-7 сек задержки. Чтобы убрать её, переключите
# STREAM_SOURCE на custom и задайте STREAM_VIDEO_INPUT (ffmpeg input args).
#
# STREAM_SOURCE=twitch        # twitch | custom (OBS / экран / RTMP / файл)
#
# Примеры STREAM_VIDEO_INPUT (ниже — это полные input-флаги ffmpeg):
#   Linux + OBS Virtual Camera:    -f v4l2 -i /dev/video0
#   Windows + OBS Virtual Camera:  -f dshow -i video="OBS Virtual Camera"
#   macOS + OBS Virtual Camera:    -f avfoundation -framerate 30 -i 'OBS Virtual Camera'
#   Linux + захват экрана:          -f x11grab -framerate 15 -i :0.0
#   Windows + захват экрана:        -f gdigrab -framerate 15 -i desktop
#   RTMP-приём от OBS:              -i rtmp://127.0.0.1/live/stream
#   NDI (через obs-ndi):            -f libndi_newtek -i 'PC-NAME (OBS Output)'
#   Локальный файл (тест):          -re -i path/to/video.mp4
# STREAM_VIDEO_INPUT=
#
# Звук (опционально, для Whisper-транскрипции):
#   Linux + Pulse:                  -f pulse -i default
#   Windows + Stereo Mix:           -f dshow -i audio="Stereo Mix"
#   macOS + BlackHole/Loopback:     -f avfoundation -i ":0"
# STREAM_AUDIO_INPUT=

# ============================================================
# === v10.4.3: per-account AI override (опционально) ===
# ============================================================
# Через UI на каждый аккаунт можно задать свою модель/ключ, чтобы боты
# не толкались в один rate-limit OpenRouter. Эти env-переменные глобальные —
# per-account overrides настраиваются через /api/accounts/{id}/ai-override.

# ============================================================
# === OPS_PLAN §3/§4: надёжность и эксплуатация ===
# ============================================================
# Retention per-bot логов (bot_logs): чистка старше N дней раз в сутки.
# 0 — не чистить. По умолчанию 30.
# BOT_LOG_RETENTION_DAYS=30

# Авто-бэкап: раз в N дней zip всей data/ складывается в AUTO_BACKUP_DIR,
# старые ротируются (хранится AUTO_BACKUP_KEEP штук). 0 — выключить.
# AUTO_BACKUP_DAYS=7
# AUTO_BACKUP_KEEP=5
# AUTO_BACKUP_DIR=data/backups

# Локальный fallback AI (Ollama) при 429/5xx/timeout облачного провайдера.
# 0/false/no — выключить.
# LOCAL_FALLBACK_ENABLED=1
# Настоящий Blur Guard через заранее созданный OBS source-filter.
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=
